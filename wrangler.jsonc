{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zacksiri-dev",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
